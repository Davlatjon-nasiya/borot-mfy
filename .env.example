# Lokal ishga tushirish uchun bu faylni ".env" deb nomlang va to'ldiring.
# Renderda esa bularni Environment bo'limiga qo'lda kiriting.

BOT_TOKEN=BotFather_dan_olingan_token

# Render PostgreSQL'dagi "Internal Database URL" (bot ham Renderda bo'lsa)
DATABASE_URL=postgresql://user:parol@host/dbname

# Umumiy guruh ID (botni guruhga qo'shib admin qiling). Masalan: -1001234567890
GROUP_ID=0

# Mutaxassislarning Telegram ID'lari (ID'ni @userinfobot orqali bilish mumkin)
ID_UCHASTKAVOY=0
ID_RAIS=0
ID_HOKIM_YORDAMCHI=0
ID_YOSHLAR=0
ID_XOTIN_QIZLAR=0
ID_SOLIQ=0
